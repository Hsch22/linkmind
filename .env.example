# LinkMind Core reads ~/.openclaw/.env first, then this file (values here win). The background service runs
# from ~/.linkmind/app and reads a copy of this file there: run scripts/dev.sh up after editing it.
# The API key lives only in ~/.openclaw/.env so OpenClaw and Core share one copy:
#   VECTRON_API_KEY=sk-...

# LLM provider: openai_compat (any OpenAI-compatible endpoint) or anthropic.
LINKMIND_PROVIDER=openai_compat
LINKMIND_BASE_URL=https://api.vectron.meta-stone.com/v1
LINKMIND_MODEL=DeepSeek/DeepSeek-V4.1-Flash
# Screenshot reading (the user waits for it); empty = LINKMIND_MODEL. V4-Flash measured ~30% faster, same accuracy.
LINKMIND_VISION_MODEL=DeepSeek/DeepSeek-V4-Flash
# For LINKMIND_PROVIDER=anthropic: ANTHROPIC_API_KEY=... and e.g. LINKMIND_MODEL=claude-opus-5-5

# Local Postgres started by scripts/pg.sh
LINKMIND_DATABASE_URL=postgresql://127.0.0.1:5544/linkmind

# MCP server (OpenClaw connects to http://127.0.0.1:8765/mcp)
LINKMIND_MCP_HOST=127.0.0.1
LINKMIND_MCP_PORT=8765

# Your WeChat nickname (comma-separate several). Merged chat-record pages and text copied on Mac show
# everyone by name, so this is how your own messages are recognised as "me". Group nicknames need no
# config: tell the bot ("我在 XX 群叫 YY") or it learns them when someone quotes you.
LINKMIND_OWNER_NAMES=

# Screenshots of the same chat arriving within this many seconds of the previous one join one source.
LINKMIND_BATCH_WINDOW_S=180

# Message you in WeChat when new material reveals that one contact's need can be met by another.
LINKMIND_PUSH_CONNECTIONS=true

# The only hosts Core fetches shared links from (exact match, comma-separated). Add hosts deliberately:
# the parser currently understands WeChat 公众号 article pages only.
LINKMIND_FETCH_HOSTS=mp.weixin.qq.com

# Seconds ingest_material waits for transcription before returning "transcribing"
# (WeChat reply window is ~1.5-2 min per turn, keep this well under).
LINKMIND_SYNC_BUDGET_S=45
